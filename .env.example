WS_URL=ws://127.0.0.1:3001
HTTP_URL=http://127.0.0.1:3000
NAPCAT_TOKEN=HTTP服务器的Token
NAPCAT_WS_TOKEN=WebSocket服务器的Token

# 填到服务商的 API 根地址，程序会追加 /chat/completions。
# 例如服务商给出 https://example.com/v1/chat/completions，则填 https://example.com/v1
# DeepSeek 官方示例：AI_BASE_URL=https://api.deepseek.com/v1  AI_MODEL=deepseek-chat
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# WebSocket 断线自动重连（默认开启）。Token 错误属于不可恢复故障，不会重连，直接报错退出。
WS_RECONNECT=true
WS_RECONNECT_INITIAL_SECONDS=2
WS_RECONNECT_MAX_SECONDS=60

# ===== 生图（可选）=====
# 需要 ai.toml 的 image_enabled = true 和 knowledge.toml 的 [image] enabled = true。
# 留空则生图不可用，聊天不受影响。
# 火山方舟（豆包 Seedream）控制台申请：https://console.volcengine.com/ark
# 还需要在控制台开通「图片生成」模型，并把模型 ID 填到 knowledge.toml 的 [image] model。
IMAGE_API_KEY=
# 一般不用填，默认 https://ark.cn-beijing.volces.com/api/v3
IMAGE_BASE_URL=
# 想临时换模型可以填这里，会覆盖 knowledge.toml 里的 model
IMAGE_MODEL=
